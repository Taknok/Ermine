+    }
+
+    @Test
+    fun `Other errors are not reported`() = runTestOnMain {
+        val crashReporter: CrashReporting = mock()
+        val feature = UnifiedPushFeature(
+            context = testContext,
+            coroutineContext = coroutineContext,
+            crashReporter = crashReporter,
