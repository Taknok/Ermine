+        assertTrue(invoked)
+        assertFalse(errorInvoked)
+    }
+
+    @Test
+    fun `unsubscribe invokes error callback on database exception`() = runTestOnMain {
+        val feature = UnifiedPushFeature(
+            context = testContext,
+            coroutineContext = coroutineContext,
+            db = db,
+        )
+        var invoked = false
