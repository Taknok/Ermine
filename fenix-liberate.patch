@@ -0,0 +1,40 @@
+package com.google.android.play.core.review;
+
+import android.app.Activity;
+import android.os.Parcel;
+import com.google.android.gms.tasks.Task;
+import com.google.android.gms.tasks.Tasks;
+
+/**
+ * Default no-op implementation used by these API dummies.
+ * It does not communicate with Google Play or display a review UI.
+ */
+final class DummyReviewManager implements ReviewManager {
+    @Override
+    public Task<ReviewInfo> requestReviewFlow() {
+        return Tasks.forResult(new DummyReviewInfo());
+    }
+
+    @Override
+    public Task<Void> launchReviewFlow(Activity activity, ReviewInfo reviewInfo) {
+        if (activity == null) {
+            throw new NullPointerException("activity");
+        }
+        if (reviewInfo == null) {
+            throw new NullPointerException("reviewInfo");
+        }
+        return Tasks.forResult(null);
+    }
+
+    private static final class DummyReviewInfo extends ReviewInfo {
+        @Override
+        public int describeContents() {
+            return 0;
+        }
+
+        @Override
+        public void writeToParcel(Parcel dest, int flags) {
+            // No state to parcel in this dummy implementation.
+        }
+    }
+}
